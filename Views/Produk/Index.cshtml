@using UITraining.Models.DB
@model List<Produk>

@{
    ViewData["Title"] = "Produk";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Data Tables</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                <li class="breadcrumb-item">Tables</li>
                <li class="breadcrumb-item active">Data</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Datatables</h5>
                        <p>Gunakan tabel ini untuk melihat daftar produk.</p>

                        <!-- Table with stripped rows -->
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nama</th>
                                    <th>Deskripsi</th>
                                    <th>Harga</th>
                                    <th>Stok</th>
                                    <th>Status</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var data in Model)
                                {
                                    if (data.ProductStatus != ProdukStatus.deleted) // Hanya tampilkan yang belum dihapus
                                    {
                                        <tr>
                                            <td>@data.Id</td>
                                            <td>@data.Name</td>
                                            <td>@data.Description</td>
                                            <td>@data.Price</td>
                                            <td>@data.Stock</td>
                                            <td>
                                                @if (data.ProductStatus == ProdukStatus.publishe)
                                                {
                                                    <span class="badge bg-success">Tersedia</span>
                                                }
                                                else if (data.ProductStatus == ProdukStatus.unpublished)
                                                {
                                                    <span class="badge bg-warning">Belum Dirilis</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Dihapus</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Edit", "Produk", new { id = data.Id })" class="btn btn-sm btn-info">Update</a>

                                                <!-- Soft Delete -->
                                                <form asp-action="Delete" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@data.Id" />
                                                    <button type="submit" class="btn btn-danger btn-sm"
                                                            onclick="return confirm('Apakah Anda yakin ingin menghapus produk ini?');">
                                                        Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <!-- End Table with stripped rows -->

                    </div>
                </div>
            </div>
        </div>
    </section>

</main><!-- End #main -->
